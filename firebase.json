{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "WebGL",
    "ignore": [
      "firebase.json",
      "firebase.test.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.unityweb",
        "headers": [{
          "key": "Content-Encoding",
          "value": "br"
        }]
      },
      {
        "source": "index.html",
        "headers": [{
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }]
      },
      {
        "source": "**/*.@(unityweb|wasm|data)",
        "headers": [{
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
